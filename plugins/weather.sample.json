{
  "id": "weather",
  "url": "https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current=temperature_2m,relative_humidity_2m,wind_speed_10m&wind_speed_unit=ms&timezone=auto",
  "city": "Hangzhou",
  "lat": "30.2936",
  "lon": "120.1614",
  "interval_s": 600,
  "map": {
    "weather.temp": {
      "path": "current.temperature_2m",
      "label": "TEMP",
      "unit": "C",
      "min": -50,
      "max": 60,
      "group": "weather"
    },
    "weather.humidity": {
      "path": "current.relative_humidity_2m",
      "label": "HUM",
      "unit": "%",
      "min": 0,
      "max": 100,
      "group": "weather"
    },
    "weather.wind": {
      "path": "current.wind_speed_10m",
      "label": "WIND",
      "unit": "m/s",
      "min": 0,
      "max": 60,
      "group": "weather"
    }
  }
}
