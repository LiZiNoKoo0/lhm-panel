# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- runtime output ----
*.log
tmp/
daemon.token
# ---- v0.6 device table: holds every terminal's key. Never commit it ----
devices.json
devices.json.tmp
# paired browsers: same class of secret as devices.json
layouts/websessions.json
websessions.json
.daemon-token

# ---- applied layouts: user work, but per-machine ----
# The file is what an operator pressed 应用 on (PROTOCOL 22.5); it is written by
# layouts.py. Keeping it out of the repo stops one machine's panel layout from
# being pushed at everybody who clones, the way a committed .env would.
layouts/*.json

# ---- Rust firmware build artifacts ----
firmware/*/target/

# ---- recorded sessions: keep the sample fixture, ignore new captures ----
recordings/*.ndjson
!recordings/session1.ndjson

# ---- OS / editor noise ----
Thumbs.db
desktop.ini
*.swp
.DS_Store

# ---- debug/probe artifacts ----
*.err
*.out
PktMon.etl
cap*.txt
_child.txt
reconnect_probe*
run-*.bat.bak*
# ---- PyInstaller output ----
dist/
build/
*.spec

# ---- TLS: the private key must never be committed ----
tls/
*.key
*.pem
_captured.ndjson
